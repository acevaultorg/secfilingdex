# secfilingdex.com — environment variables
# Copy to .env.local (git-ignored) and fill in real values.
# .env.local is read by Next.js at build time + by scripts/ping-indexnow.ts.

# ─── Analytics ─────────────────────────────────────────────────────────────

# Cloudflare Web Analytics beacon token (https://dash.cloudflare.com/?to=/:account/web-analytics)
# Used in app/layout.tsx; site works without it (GA4 is the primary).
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Google Analytics 4 measurement ID (https://analytics.google.com → Admin → Data Streams)
# Format: G-XXXXXXXXXX. Site works without it.
NEXT_PUBLIC_GA4_ID=

# Google Search Console verification meta tag (Domain property = DNS TXT, no meta needed)
# Only set if using URL-prefix property; leave empty for Domain property.
NEXT_PUBLIC_GSC_VERIFICATION=

# Microsoft Clarity Project ID — heatmaps + session recordings + UX friction detection
# Operator setup: https://clarity.microsoft.com/projects → "New project" →
#   Name: SecFilingDex
#   Website: https://secfilingdex.com
#   Category: Technology / Finance / Other
# Then grab the Project ID from Settings → Setup (alphanumeric, ~10 chars).
# Site works without it (GA4 + Cloudflare Web Analytics cover primary analytics).
# Consent-gated: Clarity respects the cookie banner via window.clarity('consent', boolean).
NEXT_PUBLIC_CLARITY_ID=

# ─── IndexNow (D5-03) ───────────────────────────────────────────────────────

# 32-char hex key for IndexNow API (https://www.bing.com/indexnow)
# Generate: openssl rand -hex 16
# Used by scripts/ping-indexnow.ts after every `npm run deploy`.
# Auto-creates out/<KEY>.txt for IndexNow domain verification.
INDEXNOW_KEY=

# ─── AdSense (Day 7+, post-approval) ────────────────────────────────────────

# Replace ads.txt placeholder with real publisher ID after AdSense approval.
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ── Affiliate activation (dormant until set) ──────────────────────────────
# PartnerTools renders nothing until one of these holds a URL.
# Full runbook: docs/AFFILIATE-ACTIVATION.md
# NOTE: adding a NEW partner needs a row in lib/partners.ts as well — static
# export inlines these by literal text substitution, so a computed env lookup
# never resolves.
NEXT_PUBLIC_AFF_DATA=
NEXT_PUBLIC_AFF_RESEARCH=
NEXT_PUBLIC_AFF_EDUCATION=
